<Window
    x:Class="SubExtractor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SubExtractor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MainRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="SubExtractor">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button x:Name="SettingsButton"
                        TitleBar.IsDragRegion="False"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings"
                        Background="Transparent"
                        BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="ContentRoot" Grid.Row="1" />
    </Grid>
</Window>
