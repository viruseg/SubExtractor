<Window
    x:Class="SubExtractor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SubExtractor.ViewModels"
    Title="SubExtractor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MainRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="SubExtractor">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarExpandedHeight">31</x:Double>
                <x:Double x:Key="TitleBarCompactHeight">31</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button x:Name="SettingsButton"
                        TitleBar.IsDragRegion="False"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings"
                        Width="46"
                        Height="31"
                        MinHeight="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <ContentControl x:Name="ContentHost"
                        Grid.Row="1"
                        IsTabStop="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <Grid x:Name="ContentRoot"
                  Padding="24,16,24,0"
                  RowSpacing="16"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="FolderBorder"
                        Grid.Row="0"
                        Padding="4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="8"
                        AllowDrop="True"
                        DragOver="FolderBorder_DragOver"
                        DragLeave="FolderBorder_DragLeave"
                        Drop="FolderBorder_Drop">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="FolderBox"
                                 AutomationProperties.Name="Folder"
                                 PlaceholderText="Folder with video files"
                                 KeyDown="FolderBox_KeyDown"
                                 LostFocus="FolderBox_LostFocus"
                                 Paste="FolderBox_Paste" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                Content="Browse..."
                                Click="BrowseButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <ScrollViewer x:Name="HeaderScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled"
                                              VerticalScrollMode="Disabled"
                                              Padding="0,0,12,0"
                                              IsTabStop="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- NOTE: must match MainViewModel.GutterWidth -->
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsRepeater Grid.Column="1"
                                                       ItemsSource="{x:Bind ViewModel.Columns, Mode=OneWay}"
                                                       HorizontalAlignment="Left">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:TableColumnViewModel">
                                                    <Grid Width="{x:Bind Width}">
                                                        <Button Visibility="{x:Bind HeaderButtonVisibility}"
                                                                Style="{StaticResource TableHeaderButtonStyle}"
                                                                Tag="{x:Bind}"
                                                                Click="ColumnHeader_Click"
                                                                AutomationProperties.Name="{x:Bind HeaderLabel}"
                                                                ToolTipService.ToolTip="{x:Bind HeaderLabel}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        Opacity="{x:Bind AccentBarOpacity, Mode=OneWay}"
                                                                        Visibility="{x:Bind AccentBarVisibility, Mode=OneWay}" />
                                                                <StackPanel Grid.Column="1" Padding="12,8,8,8" Spacing="1">
                                                                    <TextBlock Text="{x:Bind PrimaryLabel}"
                                                                               Style="{StaticResource TableHeaderTitleStyle}" />
                                                                    <TextBlock Text="{x:Bind SecondaryLabel}"
                                                                               Style="{StaticResource TableHeaderLanguageStyle}"
                                                                               Visibility="{x:Bind SecondaryLabelVisibility, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <Grid Visibility="{x:Bind HeaderLabelVisibility}">
                                                            <TextBlock Text="{x:Bind PrimaryLabel}"
                                                                       Style="{StaticResource TableHeaderTitleStyle}"
                                                                       Padding="12,8,8,8"
                                                                       VerticalAlignment="Center"
                                                                       ToolTipService.ToolTip="{x:Bind HeaderLabel}" />
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <ScrollViewer x:Name="BodyScrollViewer"
                                          Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Enabled"
                                          ViewChanged="BodyScrollViewer_ViewChanged"
                                          SizeChanged="BodyScrollViewer_SizeChanged"
                                          LayoutUpdated="BodyScrollViewer_LayoutUpdated">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TableRowViewModel">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- NOTE: must match MainViewModel.GutterWidth -->
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{x:Bind SelectionBarVisibility, Mode=OneWay}" />
                                                <Border Grid.Column="1"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:TableCellViewModel">
                                                                <Grid Width="{x:Bind Width}" Height="36">
                                                                    <ToggleButton Visibility="{x:Bind TrackCellVisibility}"
                                                                                  Style="{StaticResource TrackToggleStyle}"
                                                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                                  IsThreeState="False"
                                                                                  IsEnabled="{x:Bind HasTrack, Mode=OneWay}"
                                                                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Grid Width="17" Height="17">
                                                                                <Border Visibility="{x:Bind UncheckedIndicatorVisibility, Mode=OneWay}"
                                                                                        BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                        BorderThickness="1.5"
                                                                                        CornerRadius="5" />
                                                                                <Border Visibility="{x:Bind CheckedIndicatorVisibility, Mode=OneWay}"
                                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                        BorderThickness="1.5"
                                                                                        CornerRadius="5">
                                                                                    <Path Data="M 2.5,7 L 5.5,10 L 10.5,4"
                                                                                          Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                                          StrokeThickness="1.6"
                                                                                          StrokeStartLineCap="Round"
                                                                                          StrokeEndLineCap="Round" />
                                                                                </Border>
                                                                            </Grid>
                                                                            <TextBlock Text="&#x2014;"
                                                                                       FontSize="12"
                                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                       Visibility="{x:Bind EmptyMarkVisibility, Mode=OneWay}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,1,0" />
                                                                            <Border Style="{StaticResource FormatChipStyle}"
                                                                                    Visibility="{x:Bind FormatChipVisibility, Mode=OneWay}">
                                                                                <TextBlock Text="{x:Bind FormatLabel, Mode=OneWay}"
                                                                                           FontSize="10"
                                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </ToggleButton>
                                                                    <Button Visibility="{x:Bind FileCellVisibility}"
                                                                            Style="{StaticResource TableFileCellButtonStyle}"
                                                                            Padding="12,0,8,0"
                                                                            Tag="{x:Bind}"
                                                                            Click="FileCell_Click"
                                                                            AutomationProperties.Name="{x:Bind FileName}">
                                                                        <Grid ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{x:Bind FileName}"
                                                                                       Style="{StaticResource TableFileNameStyle}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTipService.ToolTip="{x:Bind FileName}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{x:Bind StatusText}"
                                                                                       Style="{StaticResource TableStatusStyle}"
                                                                                       Visibility="{x:Bind NoSubtitlesVisibility, Mode=OneWay}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{x:Bind StatusText}"
                                                                                       Style="{StaticResource TableCriticalStatusStyle}"
                                                                                       Visibility="{x:Bind ProbeFailedVisibility, Mode=OneWay}" />
                                                                        </Grid>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="24" />
                </Grid>
            </Grid>
        </ContentControl>

        <Grid Grid.Row="2"
              Padding="24,16,24,20"
              ColumnSpacing="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StatusButton"
                    Grid.Column="0"
                    MinHeight="32"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Activity log"
                    ToolTipService.ToolTip="Show activity log"
                    Click="StatusButton_Click">
                <TextBlock x:Name="StatusTextBlock"
                           Text="{x:Bind Log.LastMessage, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
            </Button>
            <Button x:Name="ExtractAllButton"
                    Grid.Column="1"
                    Content="Extract All"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}"
                    Click="ExtractAll_Click" />
        </Grid>
    </Grid>
</Window>
