<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SubExtractor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Unpackaged WinUI: MSIX tooling is disabled, so the SDK target that publishes the app PRI is not imported. -->
  <Target Name="IncludeProjectPriInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- WinUI ships localized MUI resources for every culture; keep only the English fallback. -->
  <Target Name="KeepEnglishWinUIResources" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_WinUIEnglishResource Include="@(None)"
                             Condition="'%(None.Extension)' == '.mui' and '%(None.Link)' == 'en-us\%(None.Filename)%(None.Extension)'" />
      <_WinUINonEnglishResource Include="@(None)"
                                Exclude="@(_WinUIEnglishResource)"
                                Condition="'%(None.Extension)' == '.mui'" />
      <None Remove="@(_WinUINonEnglishResource)" />
      <_WinUIEnglishResource Remove="@(_WinUIEnglishResource)" />
      <_WinUINonEnglishResource Remove="@(_WinUINonEnglishResource)" />
    </ItemGroup>
  </Target>

  <!-- Rider 2026.x shows the self-contained WindowsAppSDK payload in Solution view (RIDER-139070); hide it. -->
  <Target Name="HideWindowsAppSdkSelfContainedPayload" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <None Update="@(None)" Condition="'%(None.Link)' != ''">
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="RecycleBinToolkit" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubExtractor.Core\SubExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
