<Window
    x:Class="SubExtractor.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid x:Name="SettingsRoot"
              Padding="28,24,28,24"
              ColumnSpacing="16"
              RowSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="FFmpeg version"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="16"
                        MinHeight="32"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="UpdateButton"
                        MinWidth="132"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.UpdateVisibility, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                        Click="UpdateButton_Click">
                    <Grid MinWidth="112">
                        <ProgressBar x:Name="UpdateProgressBar"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                     Visibility="{x:Bind ViewModel.UpdateProgressVisibility, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.UpdateProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind ViewModel.UpdateProgressIndeterminate, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Subtitle time shift"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                <ComboBox x:Name="ShiftSignBox"
                          Width="60"
                          SelectedIndex="0"
                          AutomationProperties.Name="Time shift sign"
                          SelectionChanged="ShiftSignBox_SelectionChanged">
                    <ComboBoxItem Content="+" />
                    <ComboBoxItem Content="-" />
                </ComboBox>
                <TextBox x:Name="ShiftHoursBox"
                         Width="44"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift hours"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <TextBox x:Name="ShiftMinutesBox"
                         Width="44"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift minutes"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <TextBox x:Name="ShiftSecondsBox"
                         Width="44"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift seconds"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
                <TextBlock Text="," VerticalAlignment="Center" />
                <TextBox x:Name="ShiftMillisecondsBox"
                         Width="56"
                         MaxLength="3"
                         Text="000"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift milliseconds"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
                <TextBlock Text="Text removal"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="RulesHelpButton"
                        Width="22"
                        Height="22"
                        MinWidth="22"
                        MinHeight="22"
                        Padding="0"
                        CornerRadius="11"
                        FontSize="12"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Rule syntax"
                        AutomationProperties.Name="Text removal rule syntax"
                        Content="?">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="400" Spacing="8">
                                <TextBlock Text="One rule per line. Matching is case-insensitive. Only SRT subtitles are affected."
                                           TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Text" FontFamily="Consolas" />
                                    <Run Text=" — remove the whole line on an exact match after trimming spaces." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="@Text" FontFamily="Consolas" />
                                    <Run Text=" — remove every occurrence of Text from the line (spaces are not trimmed)." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="@@Text" FontFamily="Consolas" />
                                    <Run Text=" — same as @Text, but searches for @Text." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="#Text" FontFamily="Consolas" />
                                    <Run Text=" — remove the whole line if it contains Text (spaces are not trimmed)." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="##Text" FontFamily="Consolas" />
                                    <Run Text=" — same as #Text, but searches for #Text." />
                                </TextBlock>
                                <TextBlock Text="Empty rules and rules with only a sigil and spaces are ignored."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Rules in the first field apply only to the selected folder. Rules in the second field apply everywhere."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Text="This folder"
                       Margin="0,8,0,0"
                       VerticalAlignment="Top"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="FolderRemovalBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     MinHeight="110"
                     MaxHeight="150"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     PlaceholderText="One rule per line"
                     AutomationProperties.Name="Text removal rules for this folder"
                     TextChanged="FolderRemovalBox_TextChanged"
                     LostFocus="RemovalBox_LostFocus" />

            <TextBlock Grid.Row="4"
                       Text="All folders"
                       Margin="0,8,0,0"
                       VerticalAlignment="Top"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="GlobalRemovalBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     MinHeight="110"
                     MaxHeight="150"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     PlaceholderText="One rule per line"
                     AutomationProperties.Name="Global text removal rules"
                     TextChanged="GlobalRemovalBox_TextChanged"
                     LostFocus="RemovalBox_LostFocus" />
        </Grid>
    </ScrollViewer>
</Window>
