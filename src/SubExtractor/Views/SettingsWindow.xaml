<Window
    x:Class="SubExtractor.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <Grid x:Name="SettingsRoot"
          Padding="28,24,28,24"
          RowSpacing="12"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="FFmpeg version"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Subtitle time shift"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ComboBox x:Name="ShiftSignBox"
                          Width="60"
                          SelectedIndex="0"
                          AutomationProperties.Name="Time shift sign"
                          SelectionChanged="ShiftSignBox_SelectionChanged">
                    <ComboBoxItem Content="+" />
                    <ComboBoxItem Content="-" />
                </ComboBox>
                <TextBox x:Name="ShiftHoursBox"
                         Width="44"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift hours"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <TextBox x:Name="ShiftMinutesBox"
                         Width="44"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift minutes"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <TextBox x:Name="ShiftSecondsBox"
                         Width="44"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift seconds"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
                <TextBlock Text="," VerticalAlignment="Center" />
                <TextBox x:Name="ShiftMillisecondsBox"
                         Width="56"
                         MaxLength="3"
                         Text="000"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Time shift milliseconds"
                         BeforeTextChanging="ShiftPart_BeforeTextChanging"
                         TextChanged="ShiftPart_TextChanged"
                         GotFocus="ShiftPart_GotFocus"
                         LostFocus="ShiftPart_LostFocus" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <Button x:Name="RetryButton"
                    Content="Retry"
                    Visibility="{x:Bind ViewModel.RetryVisibility, Mode=OneWay}"
                    Click="RetryButton_Click" />
            <Button x:Name="UpdateButton"
                    MinWidth="132"
                    Visibility="{x:Bind ViewModel.UpdateVisibility, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                    Click="UpdateButton_Click">
                <Grid MinWidth="112" Height="32">
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                 Visibility="{x:Bind ViewModel.UpdateProgressVisibility, Mode=OneWay}"
                                 Value="{x:Bind ViewModel.UpdateProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.UpdateProgressIndeterminate, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Window>
