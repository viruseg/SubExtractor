<Window
    x:Class="SubExtractor.Views.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SubExtractor.Views"
    xmlns:viewModels="using:SubExtractor.ViewModels">
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <views:LogForegroundConverter x:Key="LogForegroundConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ProgressPanel" Margin="24,20,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="OverallProgress" VerticalAlignment="Center" />
            <TextBlock x:Name="PercentageText"
                       Grid.Column="1"
                       MinWidth="48"
                       VerticalAlignment="Center"
                       TextAlignment="Right" />
        </Grid>

        <ListView x:Name="LogList"
                  Grid.Row="1"
                  Margin="24,0"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:LogEntry">
                    <Grid>
                        <Grid Padding="0,2"
                              ColumnSpacing="12"
                              Visibility="{x:Bind ContentVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind Timestamp}"
                                       FontFamily="Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Message, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding IsError, Converter={StaticResource LogForegroundConverter}}" />
                        </Grid>
                        <Border Height="1"
                                Margin="0,10"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="{x:Bind SeparatorVisibility}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button x:Name="CancelButton"
                Grid.Row="2"
                Margin="24,12,24,20"
                MinWidth="96"
                HorizontalAlignment="Right"
                Content="Cancel"
                Click="CancelButton_Click" />
    </Grid>
</Window>
